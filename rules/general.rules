# Built-in general rules: the tokens most languages share (C, C++, Java, JavaScript, Python...).
# Used by ./lexer when no --rules file is given, and for languages without their own rule file.
#
# One rule per line:  NAME  PRIORITY  token|skip  REGEX
# In REGEX, \n \t \r \f \v are those characters; any other \x is a literal x.

KEYWORD    1  token  auto|break|case|char|const|continue|default|do|double|else|enum|extern|float|for|goto|if|inline|int|long|register|return|short|signed|sizeof|static|struct|switch|typedef|union|unsigned|void|volatile|while|bool|boolean|byte|catch|class|delete|extends|final|finally|implements|import|interface|namespace|new|null|nullptr|package|private|protected|public|super|template|this|throw|throws|true|false|try|using|virtual|abstract|and|as|assert|async|await|def|del|elif|except|from|global|in|is|lambda|None|nonlocal|not|or|pass|raise|self|True|False|with|yield|function|let|var|typeof|instanceof|undefined|export|of
DIRECTIVE  1  token  #[ \t]*(include|define|undef|ifdef|ifndef|if|elif|else|endif|pragma|error|warning|line)[^\n]*
COMMENT    2  skip   //[^\n]*|/\*([^*]|\*+[^*/])*\*+/|#[^\n]*
STRING     2  token  "([^"\\\n]|\\[^\n])*"|'([^'\\\n]|\\[^\n])*'|`[^`]*`
NUMBER     2  token  0[xX][0-9a-fA-F]+[uUlL]*|0[bB][01]+|[0-9]+(\.[0-9]*)?([eE][+\-]?[0-9]+)?[uUlLfFjJ]*|\.[0-9]+([eE][+\-]?[0-9]+)?[fFlLjJ]?
IDENT      2  token  [a-zA-Z_$][a-zA-Z0-9_$]*
OP         2  token  >>>=|<<=|>>=|\*\*=|\?\?=|===|!==|>>>|\?\?|\?\.|\.\.\.|->|=>|::|:=|\+\+|--|&&|\|\||==|!=|<=|>=|<<|>>|\+=|-=|\*=|/=|%=|&=|\|=|\^=|\*\*|[-+*/%=<>!&|^~?@]
PUNCT      2  token  [(){}\[\];,.:]
WS         3  skip   [ \t\r\n\f\v]+
